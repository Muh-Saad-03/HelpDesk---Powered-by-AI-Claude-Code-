# Test environment — copy to server/.env.test and fill in.
# Loaded automatically by Bun and prisma.config.ts when NODE_ENV=test.
# Must point at a SEPARATE database from .env (the test DB is wiped between runs).

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/helpdesk_test?schema=public"
PORT=3001

BETTER_AUTH_SECRET="test-only-secret-not-used-in-prod"
BETTER_AUTH_URL="http://localhost:3001"
TRUSTED_ORIGINS="http://localhost:5173"

# Optional: a deterministic admin for tests that need one.
ADMIN_EMAIL="admin@test.local"
ADMIN_PASSWORD="test-admin-password"
ADMIN_NAME="Test Admin"
