DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/helpdesk?schema=public"
PORT=3001

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="REPLACE_ME_run_openssl_rand_-base64_32"
BETTER_AUTH_URL="http://localhost:3001"

# Comma-separated list of origins allowed to call the auth API.
# Defaults to http://localhost:5173 if unset.
TRUSTED_ORIGINS="http://localhost:5173"

# Seeded admin user (used by `bun run db:seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_ME"
ADMIN_NAME="Admin"

# Shared secret required on inbound email webhooks
# (sent by the provider as the X-Webhook-Secret header).
# Generate with: openssl rand -hex 32
INBOUND_EMAIL_SECRET=""

# HTTP Basic credentials for the SendGrid Inbound Parse adapter at
# POST /api/email/inbound/sendgrid. Configure the Parse URL in SendGrid as
# `https://USER:PASS@<host>/api/email/inbound/sendgrid` — SendGrid strips
# the credentials and forwards them as an Authorization: Basic header.
SENDGRID_INBOUND_USER=""
SENDGRID_INBOUND_PASSWORD=""

# OpenAI API key — used to polish agent replies via Vercel AI SDK (gpt-5-nano).
OPENAI_API_KEY=""

# SendGrid API key for sending outbound replies via @sendgrid/mail.
# Generate at https://app.sendgrid.com/settings/api_keys (Mail Send scope).
SENDGRID_API_KEY=""

# Outbound "From" identity. The email must be a verified sender (or under
# a domain with verified Sender Authentication) on the SendGrid account.
# Use the same address that's wired up to Inbound Parse so customer
# replies route back through the inbound webhook.
OUTBOUND_FROM_EMAIL="support@example.com"
OUTBOUND_FROM_NAME="Helpdesk"

# Sentry DSN for backend error reporting. Leave blank to disable.
# Get from Sentry → Settings → Projects → <project> → Client Keys (DSN).
SENTRY_DSN=""
# Optional override for the `environment` tag — defaults to NODE_ENV.
SENTRY_ENVIRONMENT=""
