DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/helpdesk?schema=public"
PORT=3001

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="REPLACE_ME_run_openssl_rand_-base64_32"
BETTER_AUTH_URL="http://localhost:3001"

# Comma-separated list of origins allowed to call the auth API.
# Defaults to http://localhost:5173 if unset.
TRUSTED_ORIGINS="http://localhost:5173"

# Seeded admin user (used by `bun run db:seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_ME"
ADMIN_NAME="Admin"

# Shared secret required on inbound email webhooks
# (sent by the provider as the X-Webhook-Secret header).
# Generate with: openssl rand -hex 32
INBOUND_EMAIL_SECRET=""
