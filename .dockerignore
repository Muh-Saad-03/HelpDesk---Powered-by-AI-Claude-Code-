# Build artifacts and dependencies — regenerated inside the image
node_modules
**/node_modules
dist
**/dist
build
**/build
.vite
**/.vite

# Generated Prisma client (regenerated by postinstall + the `build` stage)
server/src/generated

# Local env files — never bake secrets into the image. Configure these in
# Railway's dashboard instead.
.env
.env.local
.env.test
**/.env
**/.env.local
**/.env.test

# Tests + reports — not needed at runtime
e2e
playwright
playwright.config.ts
playwright-report
test-results
**/test-results

# Editor/OS noise
.git
.gitignore
.github
.DS_Store
.vscode
.idea
*.log

# Documentation that doesn't need to ship with the runtime
README.md
CLAUDE.md
implementation-plan.md
project-scope.md
tech-stack.md
knowledge-base.md

# Skill / tooling configs
.claude
.agents
skills-lock.json

# Dockerfile itself doesn't need to be inside the image
Dockerfile
.dockerignore
